# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for production)
# Use Project URL from Supabase → Settings → API (no /rest/v1, no DB connection string)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alias supported by the app:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Help Assistant uses FAQ fallback when unset
OPENAI_API_KEY=

# After setting Vercel Production env vars, verify:
# GET /api/health/supabase → ok/reachable true
