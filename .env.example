# Demo mode (default: enabled). Set to "false" to hide demo login shortcuts.
NEXT_PUBLIC_DEMO_MODE=true

# Optional — Help Assistant uses FAQ fallback when unset
OPENAI_API_KEY=

# Optional — Supabase for durable production storage (schema in supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
